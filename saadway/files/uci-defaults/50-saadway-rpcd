#!/bin/sh
# 50-saadway-rpcd — rpcd login mapping for the optional dashboard session (T032)
#
# Auth bridge (FR-020/FR-035, constitution v1.2.0, research.md D10/D11):
# - rpcd session.login validates /etc/config/rpcd 'config login' sections via
#   crypt(3); option password '$p$<user>' = the hash is referenced from
#   /etc/shadow — so NO credential material ever lands in a world-readable UCI
#   option (the hash stays in the 0600 /etc/shadow file, written by `passwd`).
#   Upstream resolves the '$p$<name>' suffix with getspnam(<name>), so the
#   suffix MUST name the shadow row of the login user (T072).
# - The login section below maps the user to the least-privilege ACL access
#   group 'saadway' (files/rpc-acl.json → /usr/share/rpcd/acl.d/saadway.json).
# - Until provisioning has created the user, session.login('admin', …) fails
#   closed (getspnam lookup fails) — never fail open.
#
# T079 (Phase 24 — the auth bypass): the standalone dashboard performs NO
# login any more; it is authorized as rpcd's default (unauthenticated) session
# through the 'unauthenticated' ACL group in files/rpc-acl.json. The mapping
# below is therefore the OPTIONAL operator credential, and:
#   - the first-boot path MUST NOT provision a well-known default password any
#     more (no consumer is left for it, and a known password on every device
#     is a liability): the account is created on demand by the LuCI
#     credentials tab, which calls `provision set-credentials`;
#   - the credential mapping is refreshed ONLY when the account exists, so an
#     operator-set credential is never clobbered by an upgrade;
#   - the rpcd reload at the end is MANDATORY: rpcd grants the default
#     session's ACLs once at startup (openwrt/rpcd session.c:1396-1400), so a
#     running rpcd would keep the old grant set — and the dashboard would
#     stay permission-denied — until the next reboot.
#
# IMPORTANT: the heredoc is quoted ('EOF') so '$p$' reaches uci verbatim.

# 1) The login mapping: create the section only when it is missing — the ACL
#    lists belong to the creation (add_list appends, so re-adding them on an
#    existing section would duplicate the entries).
if ! uci -q get rpcd.saadway_login >/dev/null 2>&1; then
	uci -q batch <<'EOF'
add rpcd login
rename rpcd.@login[-1]='saadway_login'
add_list rpcd.saadway_login.read='saadway'
add_list rpcd.saadway_login.write='saadway'
EOF
fi

# 2) Refresh the credential mapping ONLY when the account exists: on a fresh
#    device there is no account (the dashboard needs no credential — FR-020),
#    and an operator-set credential must survive an upgrade untouched.
if grep -qs '^admin:' /etc/passwd 2>/dev/null; then
	uci -q batch <<'EOF'
set rpcd.saadway_login.username='admin'
set rpcd.saadway_login.password='$p$admin'
EOF
fi

# 3) Drop the pre-T072 login section — a stale mapping is a stale credential
#    reference (T075).
uci -q delete rpcd.saadway_admin >/dev/null 2>&1

# 4) uci batch only writes the delta under /tmp/.uci (tmpfs) — without the
#    commit the mapping (and the migration) is lost on the next reboot.
uci -q commit rpcd

# 5) Make the mapping AND the newly installed ACL groups effective for an
#    already-running rpcd (upgrade path). Mandatory: rpcd binds the default
#    session's ACLs at startup (session.c:1396-1400).
if [ -x /etc/init.d/rpcd ]; then
	/etc/init.d/rpcd reload >/dev/null 2>&1 || true
fi

exit 0
