#!/bin/sh /etc/rc.common
# procd init script for saadwayd (T008, constitution Principle I)
#
# Boot ordering (contracts/uci.md, Edge Case 4 / SC-006, T040):
#   containment (if kill_switch on) → policy apply → active profile start →
#   watchdog resume. This ordering is enforced INSIDE saadwayd's bootstrap
#   (src/main.c) so that the atomic, fail-closed sequence is applied before
#   any tunnel child is spawned; the init script merely supervises the
#   daemon under procd respawn rules.
# Lint note: START/STOP/USE_PROCD are consumed externally by /etc/rc.common
# when OpenWrt sources this file, not by this script itself (shellcheck
# cannot see that consumer; disable after verification).
# shellcheck disable=SC2034

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/saadway

start_service() {
	procd_open_instance "saadway"
	procd_set_param command "$PROG"
	# respawn: 3600s window, max 5 attempts, 5s backoff — watchdog
	# recovery (FR-026) is daemon-internal; procd only covers crashes.
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param limits core="0"
	procd_set_param stdout 0
	procd_set_param stderr 0
	# SIGHUP = re-load UCI + re-apply policy atomically (no tunnel drop)
	procd_set_param reload_signal SIGHUP
	procd_set_param file /etc/config/saadway
	procd_close_instance
}

reload_service() {
	procd_send_signal "saadway" "*" SIGHUP
}

service_triggers() {
	# Re-assert policy after fw4 settles (T-verify-3; the daemon also
	# re-asserts on its own housekeeping tick).
	procd_add_reload_trigger "firewall"
	procd_add_reload_trigger "saadway"
	# T069: procd_add_restart_trigger does not exist upstream — the
	# exported helper set has procd_add_reload_trigger (and its
	# data/interface/mount variants) only. The reload trigger is also
	# the correct semantic: a config.change on /etc/config/network
	# -> /etc/init.d/saadway reload -> the daemon's SIGHUP handler
	# re-reads UCI and re-applies the policy atomically (no tunnel drop).
	procd_add_reload_trigger "network"
}
